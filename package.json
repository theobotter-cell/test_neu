{
  "name": "contact-insights",
  "version": "1.0.0",
  "private": true,
  "description": "Bitrix24 Contact Insights app (CRM_CONTACT_DETAIL_TAB placement) deployed on Vibecode Black Hole.",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
