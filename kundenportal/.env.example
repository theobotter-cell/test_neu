# Supabase (Projekt in Region eu-central-1 / Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUR serverseitig (Einladungen, Cron-Jobs). Niemals mit NEXT_PUBLIC_ präfixen!
SUPABASE_SERVICE_ROLE_KEY=

# Öffentliche Basis-URL der Anwendung (für Links in E-Mails)
APP_URL=http://localhost:3000

# Absicherung der Cron-Endpunkte (Vercel sendet "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# E-Mail-Versand: "resend" oder "konsole" (nur Entwicklung, schreibt ins Log)
MAIL_PROVIDER=konsole
MAIL_FROM="Linxys Kundenportal <portal@linxys.de>"
RESEND_API_KEY=
